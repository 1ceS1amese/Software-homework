# 仅用于本地开发。scripts/dev.sh setup 会生成实际凭据到 .env.local。
CSMS_DB_HOST=127.0.0.1
CSMS_DB_PORT=3307
CSMS_DB_NAME=csms
CSMS_DB_USERNAME=csms
CSMS_DB_PASSWORD=replace_with_random_local_password
CSMS_MYSQL_ROOT_PASSWORD=replace_with_another_random_password
CSMS_MANAGE_DB=1
CSMS_JWT_SECRET=replace_with_random_secret_at_least_64_characters_long_before_running
SERVER_ADDRESS=127.0.0.1
# 开发代理与允许来源；修改后分别重启 Vite、后端。
VITE_API_TARGET=http://localhost:8081
CSMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
