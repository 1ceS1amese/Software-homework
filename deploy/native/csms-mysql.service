[Unit]
Description=CSMS dedicated demo MySQL
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=csms-mysql
Group=csms-mysql
ExecStart=/opt/csms/mysql/bin/mysqld --defaults-file=/etc/csms/mysql.cnf
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
RuntimeDirectory=csms-mysql
RuntimeDirectoryMode=0750
StateDirectory=csms-mysql
StateDirectoryMode=0700
LogsDirectory=csms-mysql
LogsDirectoryMode=0750
UMask=0077
LimitNOFILE=10000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/csms-mysql /var/log/csms-mysql /run/csms-mysql

[Install]
WantedBy=multi-user.target
