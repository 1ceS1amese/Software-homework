# Copy to /etc/csms/backend.env with owner root and mode 600.
# Generate real values on the target; never upload this file after configuration.
CSMS_DB_HOST=127.0.0.1
CSMS_DB_PORT=3307
CSMS_DB_NAME=csms_demo
CSMS_DB_USERNAME=csms_demo
CSMS_DB_PASSWORD=replace_with_random_database_password
CSMS_JWT_SECRET=replace_with_at_least_48_random_bytes_hex
CSMS_CORS_ALLOWED_ORIGINS=https://your_server_ip
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
TZ=Asia/Shanghai
JAVA_OPTS="-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError"
